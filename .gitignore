/target
.DS_Store

# Runtime output (SBOMs, provenance receipts) written by `sscsb sbom` /
# `sscsb receipt create` / `sscsb guac ingest` etc. — ephemeral, regenerated
# on demand. This is distinct from .sscsb/config.toml, .sscsb/policy/,
# .sscsb/hooks/, and .sscsb/rules/, which ARE committed: they're this repo's
# actual policy, not build output.
/.sscsb/out/

# Agent worktrees from the coverage build-out. The shipped agent skill under
# .claude/skills/ is deliberately re-included: it is part of the tool's
# distributed surface, not a local artifact. (A bare `/.claude/` exclusion
# cannot be negated — git will not re-include a file whose parent directory is
# excluded — hence `/*` plus an explicit un-ignore.)
/.claude/*
!/.claude/skills/

# Serena's per-project index and settings — local tool state, not policy.
/.serena/
