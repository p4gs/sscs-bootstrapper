        {
          "resource": "repo://src/init.rs#L78-L91",
          "version": "repo-lines-v1:sha256:9689579644f91aae5d1fcb7ec3c6dcb45cea771484e441ff22b49ce0ddad936c:"
        }
      ]
    },
    {
      "id": "claim_3264032eaad941b0bf27076188f95756",
      "statement": "The ignore probe uses a neutral placeholder name rather than a real artifact name, because a narrow pre-existing rule would otherwise read as full coverage and leave receipts and VEX documents exposed.",
      "evidence": [
        {
          "resource": "repo://src/init.rs#L46-L55",
          "version": "repo-lines-v1:sha256:6f84ed6053e1c2bf1450d48443aba5391d220c30a68df67ce787a2f7c663b316:"
        }
      ]
    },
    {
      "id": "claim_8a9266a68d224021a6b940f8bc33a37a",
      "statement": "The ignore rule is appended and never glued onto an unterminated final line, so a file saved without a trailing newline cannot have its last rule silently corrupted.",
